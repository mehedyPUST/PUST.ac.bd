# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for the native MongoDB driver (e.g., mongodb+srv://...)
MONGODB_URI=

# MONGODB_DB_NAME: Target database name inside MongoDB (defaults to pust_portal)
MONGODB_DB_NAME=pust_portal

# ADMIN_PASSCODE: Optional server-side passcode for Registrar/Admin sign-in override
ADMIN_PASSCODE=
